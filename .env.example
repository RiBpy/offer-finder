# Copy to .env.local for development. Never commit real values.

# MongoDB (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=offer_finder

# Public base URL, used for canonical URLs and the crawler's User-Agent
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps Platform: server-side key with Places API (New) + Geocoding API enabled.
# Leave empty to use the built-in city/country picker instead.
GOOGLE_MAPS_SERVER_KEY=

# Admin login. Generate the hash with: npm run hash-password -- 'a long password'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Open-ended offers drop to Unverified if not re-verified within this many days
OFFER_STALE_DAYS=7

# Automatic discovery (src/lib/discovery): an AI model reads news and offer pages.
# Sources are listed in src/lib/discovery/config.js. Set ONE of these keys;
# Gemini is used when both are set (override with AI_PROVIDER=gemini|anthropic).
# Gemini key: https://aistudio.google.com/apikey   Claude key: https://platform.claude.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: model used for extraction (defaults: gemini-flash-lite-latest / claude-haiku-5-5)
OFFER_AI_MODEL=
# Optional: minimum ms between AI calls (default 13000 for Gemini to fit the free
# tier's 5 requests/minute; set 0 with a paid key)
AI_MIN_INTERVAL_MS=
# Discovery runs when someone opens the app, at most once per cooldown (all
# visitors share it), reading a few pages each time. `npm run discover` runs a
# bigger batch by hand.
DISCOVERY_COOLDOWN_MIN=30
DISCOVERY_PAGES_PER_VISIT=3
# Time budget per run, in ms (Netlify functions stop at ~26 s)
DISCOVERY_BUDGET_MS=20000
